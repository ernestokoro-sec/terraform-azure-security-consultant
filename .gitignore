# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
errored.tfstate

# Terraform plans
*.tfplan
tfplan

# Variable files that may contain secrets
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive backend files
*.backend.hcl

# Local environment files
.env
.env.*

# Operating system files
.DS_Store
Thumbs.db